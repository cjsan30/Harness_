PORT=4173

# deterministic is the default and keeps harness runs stable.
# Use openai only when an API key is available.
TODO_CLASSIFIER_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# jsonl is the default local storage mode.
# Set LOG_STORE=postgres and DATABASE_URL to persist logs in PostgreSQL.
LOG_STORE=jsonl
DATABASE_URL=postgres://todo:todo@127.0.0.1:5432/todo_classifier
